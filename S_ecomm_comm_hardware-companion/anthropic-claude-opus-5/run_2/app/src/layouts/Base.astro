---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  ground?: 'light' | 'dark';
  bodyClass?: string;
}

const {
  title,
  description = 'Vela makes two cameras and supports them for a long time.',
  ground = 'light',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en" class={`ground-${ground}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={`ground-${ground} ${bodyClass}`}>
    <slot />
  </body>
</html>
