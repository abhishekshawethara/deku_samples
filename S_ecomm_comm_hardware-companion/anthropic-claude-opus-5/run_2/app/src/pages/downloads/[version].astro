---
import Shell from '../../layouts/Shell.astro';
import ReleaseBlock from '../../components/ReleaseBlock.astro';
import { formatBytes } from '../../lib/view.js';
import { query } from '../../../server/lib/db.js';

const { version } = Astro.params;

const { rows: releases } = await query('SELECT * FROM app_release ORDER BY build DESC');
const current = releases.find((r) => r.version === version);
if (!current) return new Response(null, { status: 404 });
---

<Shell title={`Arranger ${current.version} — Vela`} current="downloads">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/downloads">Downloads</a> <span aria-hidden="true">/</span>
    <span class="version">Arranger {current.version}</span>
  </nav>

  <header class="head">
    <h1>Downloads</h1>
    <p class="requirement">Arranger requires macOS 13.0 or later. Download the app below.</p>
  </header>

  <section class="primary" aria-label={`Arranger ${current.version}`}>
    <div class="primary-row">
      <a class="button button-primary get" href={`/api/releases/${current.version}`}>
        Download Arranger {current.version}
      </a>
      <div class="primary-facts">
        <span class="tnum">{formatBytes(current.size_bytes)}</span>
        <span class="digest xsmall muted">{current.sha256}</span>
      </div>
    </div>
  </section>

  <section class="archive" aria-label="Release archive">
    <h2>Every release</h2>
    <!-- This address renders its own release expanded with the rest collapsed,
         and the whole archive stays in the markup. -->
    {releases.map((r, i) => (
      <>
        {i > 0 && <div class="separator" aria-hidden="true"></div>}
        <ReleaseBlock release={r} open={r.version === current.version} />
      </>
    ))}
  </section>
</Shell>

<style>
  .crumbs {
    font-size: var(--text-sm);
    color: var(--ink-2);
    margin-bottom: var(--u4);
  }
  .crumbs a { color: var(--ink-2); }

  .head { margin-bottom: var(--u5); }
  .head h1 { font-size: var(--text-xl); margin-bottom: var(--u2); }
  .requirement { margin: 0; }

  .primary {
    padding-bottom: var(--u5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--u5);
  }
  .primary-row {
    display: flex;
    align-items: center;
    gap: var(--u4);
    flex-wrap: wrap;
  }
  .get { min-width: 220px; }
  .primary-facts {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-sm);
  }
  .digest { font-family: var(--font-mono); word-break: break-all; }

  h2 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-bottom: var(--u3);
  }

  .separator {
    height: 9px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
  }
  .separator::before {
    content: '';
    display: block;
    width: 100%;
    border-top: 1px dashed var(--rule-strong);
  }
</style>
