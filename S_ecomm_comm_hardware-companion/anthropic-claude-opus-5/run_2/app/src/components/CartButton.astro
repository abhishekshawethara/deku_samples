---
interface Props { count?: number }
const { count = 0 } = Astro.props;
// A count badge appears only above zero and reads 99+ above ninety-nine.
const badge = count > 99 ? '99+' : String(count);
const label = count === 1 ? 'Cart, 1 item' : `Cart, ${count} items`;
---

<a class="cart-button" href="/cart" aria-label={label}>
  <span aria-hidden="true" class="cart-glyph"></span>
  <span class="cart-word">Cart</span>
  {count > 0 && <span class="cart-badge tnum" aria-hidden="true">{badge}</span>}
</a>

<style>
  .cart-button {
    display: inline-flex;
    align-items: center;
    gap: var(--u2);
    min-height: 40px;
    padding: 0 var(--u3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    background: var(--surface);
    transition: background var(--speed) var(--ease);
  }
  .cart-button:hover { background: var(--surface-2); }
  .cart-glyph {
    width: 12px;
    height: 10px;
    border: 1.5px solid currentColor;
    border-top-color: transparent;
    position: relative;
  }
  .cart-glyph::before {
    content: '';
    position: absolute;
    inset: -5px 1.5px auto 1.5px;
    height: 6px;
    border: 1.5px solid currentColor;
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
  }
  .cart-badge {
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    display: inline-grid;
    place-items: center;
    background: var(--ink);
    color: var(--ground);
    border-radius: 10px;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  @media (max-width: 560px) {
    .cart-word { display: none; }
  }
</style>
