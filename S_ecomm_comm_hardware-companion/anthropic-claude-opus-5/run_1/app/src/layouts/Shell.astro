---
import Base from './Base.astro';
import CartButton from '../components/CartButton.astro';

interface Props {
  title: string;
  current?: string;
  description?: string;
}

const { title, current = '', description } = Astro.props;
const customer = Astro.locals.customer ?? null;
const cartCount = Astro.locals.cartCount ?? 0;

const shopEntries = [
  { key: 'shop', href: '/shop', label: 'Shop' },
  { key: 'downloads', href: '/downloads', label: 'Downloads' },
  { key: 'doctor', href: '/doctor', label: 'Firmware installer' },
];
// The rail holds the account sections once signed in.
const accountEntries = customer
  ? [
      { key: 'account', href: '/account', label: 'Overview' },
      { key: 'orders', href: '/account/orders', label: 'Orders' },
      { key: 'cameras', href: '/account/cameras', label: 'Cameras' },
    ]
  : [];
---

<Base title={title} description={description}>
  <a class="skip-link" href="#content">Skip to content</a>

  <div class="shell">
    <!-- On a narrow viewport the rail collapses to a single control at the top
         of the content column: the only place in the product where a control
         replaces navigation. -->
    <input type="checkbox" id="rail-toggle" class="rail-toggle-state" hidden />

    <nav class="rail" aria-label="Sections">
      <div class="rail-inner">
        <a class="wordmark" href="/">
          <span aria-hidden="true" class="wordmark-mark"></span>
          Vela
        </a>

        <ul class="rail-list">
          {shopEntries.map((e) => (
            <li>
              <a
                href={e.href}
                class:list={['rail-link', { 'rail-link-current': current === e.key }]}
                aria-current={current === e.key ? 'page' : undefined}
              >
                <span class="rail-marker" aria-hidden="true"></span>
                {e.label}
              </a>
            </li>
          ))}
        </ul>

        {accountEntries.length > 0 && (
          <>
            <p class="rail-heading" id="rail-account">Account</p>
            <ul class="rail-list" aria-labelledby="rail-account">
              {accountEntries.map((e) => (
                <li>
                  <a
                    href={e.href}
                    class:list={['rail-link', { 'rail-link-current': current === e.key }]}
                    aria-current={current === e.key ? 'page' : undefined}
                  >
                    <span class="rail-marker" aria-hidden="true"></span>
                    {e.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        <div class="rail-foot">
          {customer ? (
            <form method="post" action="/sign-out">
              <p class="xsmall muted rail-who">Signed in as {customer.email}</p>
              <button type="submit" class="button button-quiet rail-signout">Sign out</button>
            </form>
          ) : (
            <a class="button button-quiet rail-signout" href="/sign-in">Sign in</a>
          )}
        </div>
      </div>
    </nav>

    <div class="column">
      <div class="topbar">
        <label for="rail-toggle" class="rail-toggle-button">
          <span aria-hidden="true" class="rail-toggle-glyph"></span>
          Sections
        </label>
        <a class="topbar-wordmark" href="/">Vela</a>
        <CartButton count={cartCount} />
      </div>

      <main id="content" class="content" tabindex="-1">
        <slot />
      </main>

      <footer class="column-footer">
        <p class="xsmall muted">
          Vela · All rights reserved ·
          <a href="/shop">Shop</a> · <a href="/downloads">Downloads</a> ·
          <a href="/doctor">Firmware installer</a>
        </p>
      </footer>
    </div>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    min-height: 100vh;
    align-items: start;
  }

  /* The rail is fixed on a wide screen. */
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    border-right: 1px solid var(--rule);
    background: var(--surface);
    overflow-y: auto;
  }
  .rail-inner {
    display: flex;
    flex-direction: column;
    gap: var(--u4);
    padding: var(--u5) var(--u4);
    min-height: 100%;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--u2);
    font-weight: 700;
    font-size: var(--text-md);
    letter-spacing: -0.02em;
    text-decoration: none;
    min-height: 32px;
  }
  .wordmark-mark {
    width: 10px;
    height: 10px;
    background: var(--ink);
    display: inline-block;
  }

  .rail-heading {
    margin: var(--u2) 0 0;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rail-link {
    display: flex;
    align-items: center;
    gap: var(--u2);
    min-height: 40px;
    padding: 0 var(--u2);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink-2);
    font-weight: 500;
    transition: background var(--speed) var(--ease), color var(--speed) var(--ease);
  }
  .rail-link:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  /* The current entry is marked with weight and a marker as well as colour. */
  .rail-link-current {
    color: var(--ink);
    font-weight: 700;
    background: var(--surface-2);
  }
  .rail-marker {
    width: 3px;
    height: 18px;
    background: transparent;
    border-radius: 1px;
  }
  .rail-link-current .rail-marker {
    background: var(--ink);
  }

  .rail-foot {
    margin-top: auto;
    padding-top: var(--u4);
    border-top: 1px solid var(--rule);
  }
  .rail-who {
    margin: 0 0 var(--u2);
    word-break: break-all;
  }
  .rail-signout {
    width: 100%;
    min-height: 36px;
  }

  .column {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-width: 0;
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: var(--u3);
    padding: var(--u3) var(--u6);
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .topbar-wordmark {
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
    display: none;
  }
  .topbar :global(.cart-button) {
    margin-left: auto;
  }

  .rail-toggle-state { display: none; }
  .rail-toggle-button {
    display: none;
    align-items: center;
    gap: var(--u2);
    min-height: 40px;
    padding: 0 var(--u3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 0;
  }
  .rail-toggle-glyph {
    width: 14px;
    height: 2px;
    background: currentColor;
    box-shadow: 0 4px 0 currentColor, 0 -4px 0 currentColor;
  }

  .content {
    flex: 1;
    padding: var(--u6);
    max-width: 1180px;
    width: 100%;
    min-width: 0;
  }
  .content:focus {
    outline: none;
  }

  .column-footer {
    padding: var(--u4) var(--u6);
    border-top: 1px solid var(--rule);
  }
  .column-footer p { margin: 0; }
  .column-footer a { color: var(--ink-2); }

  /* The layout holds at every width between the tiers, and the page never
     scrolls sideways at any width. */
  @media (max-width: 900px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .rail {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      display: none;
    }
    .rail-toggle-state:checked ~ .rail {
      display: block;
    }
    .rail-toggle-button {
      display: inline-flex;
      order: -1;
    }
    .topbar-wordmark { display: block; }
    .topbar { padding: var(--u3) var(--u4); }
    .content { padding: var(--u4); }
    .column-footer { padding: var(--u4); }
  }
</style>
