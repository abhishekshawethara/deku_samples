---
import Shell from '../../layouts/Shell.astro';
import CameraCard from '../../components/CameraCard.astro';
import { formatMoney, formatDateTime } from '../../lib/view.js';
import { query } from '../../../server/lib/db.js';
import { decorateDevice } from '../../../server/lib/devices.js';
import { orderLines, orderChip } from '../../../server/lib/orders.js';

const customer = Astro.locals.customer;

// Blocks on the account overview fail independently, so a failed camera list
// never blanks the orders beside it.
async function safely(work) {
  try {
    return { ok: true, value: await work() };
  } catch (err) {
    return { ok: false, value: null };
  }
}

const camerasBlock = await safely(async () => {
  const { rows } = await query(
    `SELECT d.*, p.title AS model, p.handle, v.option_value
       FROM device_ownership o
       JOIN device d ON d.id = o.device_id
       JOIN product p ON p.id = d.product_id
       JOIN variant v ON v.id = d.variant_id
      WHERE o.customer_id = $1 AND o.released_at IS NULL
      ORDER BY d.id`,
    [customer.id],
  );
  return Promise.all(rows.map(decorateDevice));
});

const ordersBlock = await safely(async () => {
  // The two most recent orders.
  const { rows } = await query(
    'SELECT * FROM "order" WHERE customer_id = $1 ORDER BY id DESC LIMIT 2',
    [customer.id],
  );
  return Promise.all(
    rows.map(async (o) => {
      const lines = await orderLines(o.id);
      return {
        ...o,
        chip: orderChip(o),
        summary: lines.length > 1
          ? `${lines[0].title_snapshot} and ${lines.length - 1} more`
          : (lines[0]?.title_snapshot ?? ''),
      };
    }),
  );
});

const softwareBlock = await safely(async () => {
  const { rows } = await query('SELECT * FROM app_release ORDER BY build DESC LIMIT 1');
  return rows[0];
});

// Whether the newest release is newer than the one this account last saw.
const seenBuild = Number(Astro.cookies.get('vela_seen_build')?.value || 0);
const newest = softwareBlock.value;
const isNewer = !!(newest && newest.build > seenBuild);
if (newest) {
  Astro.cookies.set('vela_seen_build', String(newest.build), {
    path: '/', sameSite: 'lax', maxAge: 60 * 60 * 24 * 365,
  });
}
---

<Shell title="Account — Vela" current="account">
  <header class="head">
    <h1>Your account</h1>
    <p class="muted small">Signed in as {customer.email}</p>
  </header>

  <!-- Cameras first, then the two most recent orders, then the software.
       Deliberately not a shop's order. -->
  <section class="block" aria-labelledby="cameras-heading">
    <div class="block-head">
      <h2 id="cameras-heading">Your cameras</h2>
      <a class="block-more" href="/account/cameras">All cameras</a>
    </div>
    {!camerasBlock.ok ? (
      <p class="notice notice-wrong">We could not load your cameras. Try again in a moment.</p>
    ) : camerasBlock.value.length === 0 ? (
      <div class="empty-state">
        <p>No cameras registered yet.</p>
        <p><a href="/account/cameras">Register one</a></p>
      </div>
    ) : (
      <ul class="grid">
        {camerasBlock.value.map((d) => <CameraCard device={d} />)}
      </ul>
    )}
  </section>

  <section class="block" aria-labelledby="orders-heading">
    <div class="block-head">
      <h2 id="orders-heading">Recent orders</h2>
      <a class="block-more" href="/account/orders">All orders</a>
    </div>
    {!ordersBlock.ok ? (
      <p class="notice notice-wrong">We could not load your orders. Try again in a moment.</p>
    ) : ordersBlock.value.length === 0 ? (
      <div class="empty-state">
        <p>No orders yet.</p>
        <p><a href="/shop">Shop</a></p>
      </div>
    ) : (
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Number</th>
            <th scope="col">Placed</th>
            <th scope="col">What</th>
            <th scope="col" class="num">Total</th>
            <th scope="col">State</th>
          </tr>
        </thead>
        <tbody>
          {ordersBlock.value.map((o) => (
            <tr>
              <td><a class="tnum number" href={`/account/orders/${o.number}`}>{o.number}</a></td>
              <td>{formatDateTime(o.placed_at)}</td>
              <td>{o.summary}</td>
              <td class="num money">{formatMoney(o.total_minor)} {String(o.currency).toUpperCase()}</td>
              <td><span class:list={['chip', `chip-${o.chip.tone}`]}>{o.chip.text}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>

  <section class="block" aria-labelledby="software-heading">
    <div class="block-head">
      <h2 id="software-heading">Software</h2>
      <a class="block-more" href="/downloads">Downloads</a>
    </div>
    {!softwareBlock.ok || !newest ? (
      <p class="notice notice-wrong">We could not load the release list. Try again in a moment.</p>
    ) : (
      <div class="software card">
        <div>
          <p class="software-version">Arranger <span class="version">{newest.version}</span></p>
          <p class="xsmall muted">Build <span class="tnum">{newest.build}</span></p>
        </div>
        {isNewer
          ? <span class="chip chip-progress">Newer than the one you last saw</span>
          : <span class="chip">You have seen this release</span>}
        <a class="button button-quiet" href={`/downloads/${newest.version}`}>Read the notes</a>
      </div>
    )}
  </section>
</Shell>

<style>
  .head { margin-bottom: var(--u5); }
  .head h1 { font-size: var(--text-xl); margin-bottom: var(--u); }
  .head p { margin: 0; }

  .block { margin-bottom: var(--u6); }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--u3);
    margin-bottom: var(--u3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--u2);
  }
  .block-head h2 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .block-more { font-size: var(--text-sm); color: var(--ink-2); }
  .number { font-weight: 600; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(248px, 1fr));
    gap: var(--u3);
  }

  .software {
    display: flex;
    align-items: center;
    gap: var(--u4);
    padding: var(--u3);
    flex-wrap: wrap;
  }
  .software-version { margin: 0; font-weight: 600; }
  .software .button { margin-left: auto; }

  @media (max-width: 640px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .software .button { margin-left: 0; }
  }
</style>
