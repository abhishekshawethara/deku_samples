---
import Shell from '../../../layouts/Shell.astro';
import CameraCard from '../../../components/CameraCard.astro';
import { query } from '../../../../server/lib/db.js';
import { decorateDevice, registerDevice } from '../../../../server/lib/devices.js';

const customer = Astro.locals.customer;

let formError = '';
let formOk = '';

// The register row also works with no scripting.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const serial = String(form.get('serial') ?? '');
  try {
    await registerDevice(serial, customer.id);
    formOk = 'That camera is now on your account.';
  } catch (err: any) {
    formError = err?.message || 'That did not work.';
  }
}

const { rows } = await query(
  `SELECT d.*, p.title AS model, p.handle, v.option_value
     FROM device_ownership o
     JOIN device d ON d.id = o.device_id
     JOIN product p ON p.id = d.product_id
     JOIN variant v ON v.id = d.variant_id
    WHERE o.customer_id = $1 AND o.released_at IS NULL
    ORDER BY d.id`,
  [customer.id],
);
const devices = await Promise.all(rows.map(decorateDevice));
---

<Shell title="Cameras — Vela" current="cameras">
  <header class="head">
    <h1>Cameras</h1>
    <p class="muted small">The cameras registered to this account.</p>
  </header>

  <form class="register card" method="post" data-register>
    <div class="register-field">
      <label for="serial">Register a camera</label>
      <input type="text" id="serial" name="serial" class="serial" maxlength="14"
        placeholder="VA2609KTMHX4" autocomplete="off" spellcheck="false"
        aria-describedby="serial-hint" required />
    </div>
    <button type="submit" class="button">Register</button>
    <p class="field-hint" id="serial-hint">Twelve characters from the underside of the camera.</p>
    <p class="register-message" data-register-message role="status" aria-live="polite"></p>
    {formError && <p class="register-message register-wrong">{formError}</p>}
    {formOk && <p class="register-message register-done">{formOk}</p>}
  </form>

  <p class="empty-state" data-camera-empty hidden={devices.length > 0}>No cameras registered yet.</p>

  <ul class="grid" data-camera-grid hidden={devices.length === 0}>
    {devices.map((d) => <CameraCard device={d} />)}
  </ul>

  <script>
    import '../../../scripts/register-camera.js';
  </script>
</Shell>

<style>
  .head { margin-bottom: var(--u4); }
  .head h1 { font-size: var(--text-xl); margin-bottom: var(--u); }
  .head p { margin: 0; }

  .register {
    display: grid;
    grid-template-columns: minmax(0, 260px) auto;
    gap: var(--u2) var(--u3);
    align-items: end;
    padding: var(--u3);
    margin-bottom: var(--u4);
  }
  .register-field { margin: 0; }
  .register .field-hint { grid-column: 1 / -1; margin: 0; }
  .register-message { grid-column: 1 / -1; margin: 0; font-size: var(--text-sm); font-weight: 600; }
  .register-message:empty { display: none; }
  .register-wrong { color: var(--wrong); }
  .register-done { color: var(--finished); }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(248px, 1fr));
    gap: var(--u3);
  }

  @media (max-width: 640px) {
    .register { grid-template-columns: minmax(0, 1fr); }
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
