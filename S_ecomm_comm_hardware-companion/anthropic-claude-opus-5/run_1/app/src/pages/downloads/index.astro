---
import Shell from '../../layouts/Shell.astro';
import ReleaseBlock from '../../components/ReleaseBlock.astro';
import { formatBytes } from '../../lib/view.js';
import { query } from '../../../server/lib/db.js';

// Sort by build descending; released_on is not a sort key, so 1.4.3 and 1.4.2
// sharing a release date still order deterministically.
const { rows: releases } = await query('SELECT * FROM app_release ORDER BY build DESC');
const newest = releases[0];

const { rows: firmware } = await query(
  `SELECT f.*, p.title AS model, p.handle
     FROM firmware f JOIN product p ON p.id = f.product_id
    WHERE f.channel = 'general'
    ORDER BY p.position, f.build DESC`,
);
const cricketFirmware = firmware.find((f) => f.handle === 'compact');
---

<Shell title="Downloads — Vela" current="downloads">
  <header class="head">
    <h1>Downloads</h1>
    <p class="requirement">Arranger requires macOS 13.0 or later. Download the app below.</p>
  </header>

  <section class="primary" aria-label="Arranger">
    <div class="primary-row">
      <!-- Adapts to the reader's platform but is never disabled and never
           hidden, because fetching an installer on a work laptop for a machine
           at home is an ordinary thing to do. -->
      <a class="button button-primary get" href={`/downloads/${newest.version}`} data-platform-control>
        Download Arranger {newest.version}
      </a>
      <div class="primary-facts">
        <span class="tnum">{formatBytes(newest.size_bytes)}</span>
        <span class="digest xsmall muted">{newest.sha256}</span>
      </div>
    </div>
    <p class="xsmall muted platform-note" data-platform-note hidden>Arranger is a macOS application.</p>
  </section>

  <section class="firmware" aria-label="Firmware">
    <h2>Firmware</h2>
    <div class="firmware-row">
      {cricketFirmware && (
        <a class="button" href={`/api/firmware/manifest?model=${cricketFirmware.handle}`}>
          Download {cricketFirmware.model} Firmware {cricketFirmware.version}
        </a>
      )}
      <!-- The web path is never the primary control. -->
      <div class="web-path">
        <a class="quiet-link" href="/doctor">Firmware install (web-based)</a>
        <p class="xsmall muted warning">Only use this if Arranger cannot see your camera.</p>
      </div>
    </div>
  </section>

  <section class="archive" aria-label="Release archive">
    <h2>Every release</h2>
    {releases.map((r, i) => (
      <>
        {i > 0 && <div class="separator" aria-hidden="true"></div>}
        <ReleaseBlock release={r} open={i === 0} />
      </>
    ))}
  </section>

  <script>
    // The only thing the control adapts is its wording; it is never disabled
    // and never hidden.
    const note = document.querySelector('[data-platform-note]');
    const isMac = /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent);
    if (note && !isMac) note.hidden = false;
  </script>
</Shell>

<style>
  .head { margin-bottom: var(--u5); }
  .head h1 { font-size: var(--text-xl); margin-bottom: var(--u2); }
  .requirement { margin: 0; font-size: var(--text-md); }

  .primary {
    padding-bottom: var(--u5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--u5);
  }
  .primary-row {
    display: flex;
    align-items: center;
    gap: var(--u4);
    flex-wrap: wrap;
  }
  .get { min-width: 220px; }
  .primary-facts {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-sm);
  }
  .digest {
    font-family: var(--font-mono);
    word-break: break-all;
  }
  .platform-note { margin: var(--u2) 0 0; }

  .firmware {
    padding-bottom: var(--u5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--u5);
  }
  h2 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-bottom: var(--u3);
  }
  .firmware-row {
    display: flex;
    align-items: flex-start;
    gap: var(--u6);
    flex-wrap: wrap;
  }
  .web-path { max-width: 32ch; }
  .quiet-link {
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .warning { margin: 0; }

  /* A plain horizontal bar carrying a dashed rule inside it: the only
     decorative element on the page. */
  .separator {
    height: 9px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
  }
  .separator::before {
    content: '';
    display: block;
    width: 100%;
    border-top: 1px dashed var(--rule-strong);
  }
</style>
